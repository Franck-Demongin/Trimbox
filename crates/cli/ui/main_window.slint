import { VerticalBox, HorizontalBox, Button, LineEdit, ScrollView, StandardButton, Palette } from "std-widgets.slint";

struct SnackbarItem {
    text: string,
    level: int,
    id: int,
}

global Theme {
    out property <length> spacing: 8px;
    out property <length> window-preferred-width: 860px;
    out property <length> window-preferred-height: 520px;
    out property <length> window-min-width: 760px;
    out property <length> window-min-height: 460px;
    out property <length> dialog-width: 760px;
    out property <length> dialog-height: 500px;
    out property <length> dialog-vertical-margin: 45px;
    out property <length> label-min-width: 72px;
    out property <length> crop-field-min-width: 120px;
    out property <length> frame-min-height: 240px;
    out property <length> corner-radius: 6px;
}

component Snackbar inherits Rectangle {
    in property <string> text: "";
    in property <int> level: 0;
    in property <int> id: 0;

    callback close-requested();

    background: Palette.alternate-background;
    border-color: Palette.border;
    border-width: 1px;
    border-radius: Theme.corner-radius;
    height: self.preferred-height;

    HorizontalBox {
        padding: Theme.spacing;
        spacing: Theme.spacing;
        alignment: stretch;

        Text {
            text: root.text;
            color: Palette.foreground;
            wrap: word-wrap;
            horizontal-alignment: left;
            vertical-alignment: top;
            horizontal-stretch: 1;
        }

        Rectangle {
            width: 24px;
            height: 24px;
            horizontal-stretch: 0;
            border-radius: 12px;
            background: Palette.control-background;

            Text {
                width: 24px;
                height: 24px;
                text: "×";
                color: Palette.control-foreground;
                font-size: 18px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                width: 24px;
                height: 24px;
                clicked => {
                    root.close-requested();
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Trimbox";
    preferred-width: Theme.window-preferred-width;
    preferred-height: Theme.window-preferred-height;
    min-width: Theme.window-min-width;
    min-height: Theme.window-min-height;

    in-out property <string> source-path: "";
    in-out property <string> output-path: "";
    in-out property <string> crop-width-mm: "85";
    in-out property <string> crop-height-mm: "55";
    in property <string> report-title: "Résultat";
    in property <string> report: "";
    in property <bool> output-available: false;
    in property <bool> report-available: false;
    in-out property <[SnackbarItem]> snackbar-items: [];

    in-out property <bool> report-visible: false;

    callback browse-source();
    callback browse-output();
    callback crop();
    callback open-output();
    callback open-output-folder();

    callback open-report();
    callback close-report();

    callback close-snackbar(int);

    open-report => {
        report_popup.show();
        root.report-visible = true;
    }

    close-report => {
        report_popup.close();
        root.report-visible = false;
    }

    VerticalBox {
        spacing: Theme.spacing;
        padding: Theme.spacing;
        alignment: stretch;

        Rectangle {
            background: Palette.alternate-background;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: Theme.corner-radius;
            vertical-stretch: 0;
            horizontal-stretch: 1;
            height: self.preferred-height;

            VerticalBox {
                padding: Theme.spacing;
                spacing: Theme.spacing;
                vertical-stretch: 0;

                Text { text: "Source"; vertical-alignment: center; }
                HorizontalBox {
                    spacing: Theme.spacing;
                    alignment: stretch;
                    vertical-stretch: 0;
                    LineEdit { text <=> root.source-path; placeholder-text: "Chemin du PDF source"; horizontal-stretch: 1; }
                    Button { text: "Parcourir..."; horizontal-stretch: 0; clicked => { root.browse-source(); } }
                }
            }
        }

        Rectangle {
            background: Palette.alternate-background;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: Theme.corner-radius;
            vertical-stretch: 0;
            horizontal-stretch: 1;
            height: self.preferred-height;

            VerticalBox {
                padding: Theme.spacing;
                spacing: Theme.spacing;
                vertical-stretch: 0;

                Text { text: "Sortie"; vertical-alignment: center; }
                HorizontalBox {
                    spacing: Theme.spacing;
                    alignment: stretch;
                    vertical-stretch: 0;
                    LineEdit { text <=> root.output-path; placeholder-text: "Chemin du PDF généré"; horizontal-stretch: 1; }
                    Button { text: "Parcourir..."; horizontal-stretch: 0; clicked => { root.browse-output(); } }
                }
            }
        }

        Rectangle {
            background: Palette.alternate-background;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: Theme.corner-radius;
            vertical-stretch: 0;
            horizontal-stretch: 1;
            height: self.preferred-height;

            VerticalBox {
                padding: Theme.spacing;
                spacing: Theme.spacing;
                vertical-stretch: 0;

                HorizontalBox {
                    spacing: Theme.spacing;
                    vertical-stretch: 0;
                    Text { text: "Largeur crop (mm)"; vertical-alignment: center; }
                    Text { text: "Hauteur crop (mm)"; vertical-alignment: center; }
                }

                HorizontalBox {
                    spacing: Theme.spacing;
                    vertical-stretch: 0;
                    LineEdit { text <=> root.crop-width-mm; placeholder-text: "85"; horizontal-stretch: 1; min-width: Theme.crop-field-min-width; }
                    LineEdit { text <=> root.crop-height-mm; placeholder-text: "55"; horizontal-stretch: 1; min-width: Theme.crop-field-min-width; }
                }
            }
        }

        Rectangle {
            min-height: 0px;
            vertical-stretch: 1;
        }

        HorizontalBox {
            spacing: Theme.spacing;
            alignment: end;
            vertical-stretch: 0;

            if root.report-available : Button {
                text: "Rapport";
                horizontal-stretch: 0;
                clicked => {
                    root.open-report();
                }
            }

            if root.output-available : Button {
                text: "Ouvrir le fichier";
                horizontal-stretch: 0;
                clicked => { root.open-output(); }
            }

            if root.output-available : Button {
                text: "Ouvrir le dossier";
                horizontal-stretch: 0;
                clicked => { root.open-output-folder(); }
            }

            Button {
                text: "Recadrer";
                primary: true;
                horizontal-stretch: 0;
                clicked => { root.crop(); }
            }
        }
    }

    Rectangle {
        visible: root.snackbar-items.length > 0;
        width: min(460px, max(0px, root.width - Theme.spacing * 4));
        height: self.preferred-height;
        x: max(Theme.spacing * 2, root.width - self.width - Theme.spacing * 2);
        y: Theme.spacing * 2;
        background: transparent;

        VerticalBox {
            spacing: Theme.spacing;
            for i in root.snackbar-items.length : Snackbar {
                text: root.snackbar-items[root.snackbar-items.length - 1 - i].text;
                level: root.snackbar-items[root.snackbar-items.length - 1 - i].level;
                id: root.snackbar-items[root.snackbar-items.length - 1 - i].id;
                close-requested => { root.close-snackbar(self.id); }
            }
        }
    }

    report_popup := PopupWindow {
        close-policy: no-auto-close;
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        report_focus := FocusScope {
            in property <bool> report-open: root.report-visible;

            changed report-open => {
                if self.report-open {
                    self.focus();
                }
            }

            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;

            capture-key-pressed(event) => {
                if root.report-visible && event.text == Key.Escape {
                    root.close-report();
                    return accept;
                }
                reject
            }

            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                background: #00000080;

                backdrop := TouchArea {
                    clicked => { }
                }
            }

            report_dialog := Dialog {
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
                width: root.width >= Theme.dialog-width ? Theme.dialog-width : root.width;
                height: root.height >= Theme.window-preferred-height ? Theme.dialog-height : root.height - Theme.dialog-vertical-margin;
                title: root.report-title;

                VerticalBox {
                    padding: Theme.spacing;
                    spacing: Theme.spacing;
                    alignment: stretch;

                    Rectangle {
                        background: Palette.alternate-background;
                        border-color: Palette.border;
                        border-width: 1px;
                        border-radius: Theme.corner-radius;
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        min-height: Theme.frame-min-height;
                        clip: true;

                        TouchArea {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            clicked => { }
                        }

                        ScrollView {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            content-width: self.visible-width;
                            horizontal-scrollbar-policy: always-off;

                            VerticalBox {
                                padding: Theme.spacing;
                                spacing: 0px;
                                alignment: stretch;

                                Text {
                                    text: root.report;
                                    width: 100%;
                                    min-width: 0px;
                                    wrap: word-wrap;
                                    vertical-alignment: top;
                                    horizontal-alignment: left;
                                    font-family: "monospace";
                                    font-size: 12px;
                                    color: Palette.foreground;
                                }
                            }
                        }
                    }
                }

                StandardButton {
                    kind: close;
                    clicked => {
                        root.close-report();
                    }
                }
            }
        }
    }
}
