import { VerticalBox, HorizontalBox, Button, LineEdit, ScrollView, StandardButton, Palette } from "std-widgets.slint";

global Theme {
    out property <length> spacing: 8px;
}

export component MainWindow inherits Window {
    title: "Trimbox";
    preferred-width: 860px;
    preferred-height: 520px;
    min-width: 760px;
    min-height: 460px;

    in-out property <string> source-path: "";
    in-out property <string> output-path: "";
    in-out property <string> crop-width-mm: "85";
    in-out property <string> crop-height-mm: "55";
    in property <string> report-title: "Résultat";
    in property <string> report: "";
    in property <bool> output-available: false;
    in property <bool> report-available: false;
    in property <string> status: "Prêt.";
    in property <int> status-level: 0;

    in-out property <bool> report-visible: false;

    callback browse-source();
    callback browse-output();
    callback crop();
    callback open-output();
    callback open-output-folder();

    VerticalBox {
        spacing: Theme.spacing;
        padding: Theme.spacing;
        alignment: stretch;

        Text {
            text: "Trimbox";
            font-size: 20px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-stretch: 0;
        }

        Rectangle {
            background: root.status-level == 2 ? #fdeeee : (root.status-level == 1 ? #fff7e6 : #eef7ee);
            border-color: root.status-level == 2 ? #c62828 : (root.status-level == 1 ? #f9a825 : #2e7d32);
            border-width: 1px;
            border-radius: 6px;
            horizontal-stretch: 1;
            vertical-stretch: 0;

            Text {
                text: root.status;
                color: root.status-level == 2 ? #c62828 : (root.status-level == 1 ? #f9a825 : #2e7d32);
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        HorizontalBox {
            spacing: Theme.spacing;
            alignment: stretch;
            vertical-stretch: 0;
            Text { text: "Source"; min-width: 72px; vertical-alignment: center; }
            LineEdit { text <=> root.source-path; placeholder-text: "Chemin du PDF source"; horizontal-stretch: 1; }
            Button { text: "Parcourir..."; horizontal-stretch: 0; clicked => { root.browse-source(); } }
        }

        HorizontalBox {
            spacing: Theme.spacing;
            alignment: stretch;
            vertical-stretch: 0;
            Text { text: "Sortie"; min-width: 72px; vertical-alignment: center; }
            LineEdit { text <=> root.output-path; placeholder-text: "Chemin du PDF généré"; horizontal-stretch: 1; }
            Button { text: "Choisir..."; horizontal-stretch: 0; clicked => { root.browse-output(); } }
        }

        HorizontalBox {
            spacing: Theme.spacing;
            vertical-stretch: 0;
            Text { text: "Largeur crop (mm)"; vertical-alignment: center; }
            LineEdit { text <=> root.crop-width-mm; placeholder-text: "85"; horizontal-stretch: 1; min-width: 120px; }
            Text { text: "Hauteur crop (mm)"; vertical-alignment: center; }
            LineEdit { text <=> root.crop-height-mm; placeholder-text: "55"; horizontal-stretch: 1; min-width: 120px; }
        }

        Rectangle {
            min-height: 0px;
            vertical-stretch: 1;
        }

        HorizontalBox {
            spacing: Theme.spacing;
            alignment: end;
            vertical-stretch: 0;

            if root.report-available : Button {
                text: "Rapport";
                horizontal-stretch: 0;
                clicked => {
                    root.report-visible = true;
                    report_popup.show();
                }
            }

            if root.output-available : Button {
                text: "Ouvrir le fichier";
                horizontal-stretch: 0;
                clicked => { root.open-output(); }
            }

            if root.output-available : Button {
                text: "Ouvrir le dossier";
                horizontal-stretch: 0;
                clicked => { root.open-output-folder(); }
            }

            Button {
                text: "Recadrer";
                primary: true;
                horizontal-stretch: 0;
                clicked => { root.crop(); }
            }
        }
    }

    report_popup := PopupWindow {
        close-policy: no-auto-close;
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        report_focus := FocusScope {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;

            capture-key-pressed(event) => {
                if root.report-visible && event.text == Key.Escape {
                    report_popup.close();
                    root.report-visible = false;
                    return accept;
                }
                reject
            }

            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                background: #00000080;

                backdrop := TouchArea {
                    clicked => {
                        report_popup.close();
                        root.report-visible = false;
                    }
                }
            }

            report_dialog := Dialog {
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
                width: 760px;
                height: 500px;
                title: root.report-title;

                VerticalBox {
                    padding: Theme.spacing;
                    spacing: Theme.spacing;
                    alignment: stretch;

                    Text {
                        text: root.report-title;
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-alignment: left;
                        vertical-stretch: 0;
                    }

                    Rectangle {
                        background: Palette.alternate-background;
                        border-color: Palette.border;
                        border-width: 1px;
                        border-radius: 6px;
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        min-height: 240px;
                        clip: true;

                        TouchArea {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            clicked => { }
                        }

                        ScrollView {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            content-width: self.visible-width;
                            horizontal-scrollbar-policy: always-off;

                            VerticalBox {
                                padding: Theme.spacing;
                                spacing: 0px;
                                alignment: stretch;

                                Text {
                                    text: root.report;
                                    width: 100%;
                                    min-width: 0px;
                                    wrap: word-wrap;
                                    vertical-alignment: top;
                                    horizontal-alignment: left;
                                    font-family: "monospace";
                                    font-size: 12px;
                                    color: Palette.foreground;
                                }
                            }
                        }
                    }
                }

                StandardButton {
                    kind: close;
                    clicked => {
                        report_popup.close();
                        root.report-visible = false;
                    }
                }
            }
        }
    }
}
