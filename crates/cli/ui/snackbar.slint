import { VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct SnackbarItem {
    text: string,
    level: int,
    id: int,
    closing: bool,
}

export component Snackbar inherits Rectangle {
    in property <string> text: "";
    in property <int> level: 0;
    in property <int> id: 0;

    in property <bool> closing: false;
    property <bool> entered: false;
    init => { root.entered = true; }

    callback close-requested();

    in property <length> spacing: 8px;
    in property <length> corner-radius: 6px;

    background: self.level == 2 ? #e53935 : (self.level == 1 ? #f08c00 : #2e9f54);
    border-color: self.level == 2 ? #9b000e : (self.level == 1 ? #a66100 : #1d6f3a);
    border-width: 1px;
    border-radius: root.corner-radius;
    opacity: !root.closing && root.entered ? 1.0 : 0.0;
    height: !root.closing && root.entered ? self.preferred-height : 0px;
    clip: true;

    animate opacity {
        duration: 1000ms;
        easing: ease-in-out;
    }
    animate height {
        duration: 200ms;
        easing: ease-in-out;
    }

    HorizontalBox {
        padding: root.spacing;
        spacing: root.spacing;
        alignment: stretch;

        Text {
            text: root.text;
            color: root.level == 2 ? #ffffff : (root.level == 1 ? #111111 : #ffffff);
            wrap: word-wrap;
            horizontal-alignment: left;
            vertical-alignment: top;
            horizontal-stretch: 1;
        }

        Rectangle {
            width: 24px;
            height: 24px;
            horizontal-stretch: 0;
            border-radius: 12px;
            background: root.level == 2 ? #9b000e : (root.level == 1 ? #a66100 : #1d6f3a);

            Image {
                x: 5px;
                y: 5px;
                width: 14px;
                height: 14px;
                source: @image-url("../../../assets/icons/ui/close.svg");
                image-fit: contain;
            }

            TouchArea {
                width: 24px;
                height: 24px;
                enabled: !root.closing;
                clicked => {
                    root.close-requested();
                }
            }
        }
    }
}

export component SnackbarOverlay inherits Rectangle {
    in property <[SnackbarItem]> items;
    in property <length> available-width: 860px;
    in property <length> spacing: 8px;

    callback close-requested(int);

    visible: root.items.length > 0;
    width: min(360px, max(0px, root.available-width - root.spacing * 4));
    height: self.preferred-height;
    x: max(root.spacing * 2, root.available-width - self.width - root.spacing * 2);
    y: root.spacing * 2;
    background: transparent;

    VerticalBox {
        spacing: root.spacing;
        for i in root.items.length : Snackbar {
            text: root.items[root.items.length - 1 - i].text;
            level: root.items[root.items.length - 1 - i].level;
            id: root.items[root.items.length - 1 - i].id;
            closing: root.items[root.items.length - 1 - i].closing;
            close-requested => { root.close-requested(self.id); }
        }
    }
}
